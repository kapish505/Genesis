GENESIS_ENV=development
GENESIS_BUILDS_ENABLED=true
GENESIS_DATABASE_PATH=./genesis.db
GENESIS_GATEWAY_URL=http://localhost:8080
GENESIS_GATEWAY_SECRET=replace-me
GENESIS_AGENTVERSE_API_KEY=
GENESIS_ASI1_API_KEY=
GENESIS_TAVILY_API_KEY=
GENESIS_AGENTVERSE_BASE_URL=https://agentverse.ai
GENESIS_ASI1_BASE_URL=https://api.asi1.ai/v1
GENESIS_ASI1_MODEL=asi1
GENESIS_DISCOVERY_TIMEOUT_S=120
GENESIS_MATCH_THRESHOLD=0.72
GENESIS_BORDERLINE_THRESHOLD=0.40
GENESIS_MAX_CONCURRENT_BUILDS=2
GENESIS_MAX_LIVE_AGENTS=50
GENESIS_PAYMENTS_ENABLED=false
